# =============================================================================
# Open Agents — Environment Configuration
# =============================================================================
# This fork supports both Vercel and Cloudflare infrastructure.
# Set the variables for your chosen platform.

# --- Database (required) ---
# Any PostgreSQL-compatible connection string works:
#   - Neon Postgres, Supabase, self-hosted, etc.
#   - For Cloudflare: use Hyperdrive URL for connection pooling
DATABASE_URL=
# Legacy aliases (still supported):
# POSTGRES_URL=
# HYPERDRIVE_URL=

# --- Auth secrets (required) ---
JWE_SECRET=
# Must be a 32-byte hex string (64 characters)
ENCRYPTION_KEY=

# --- GitHub App (required for repo access, pushes, and PRs) ---
# Callback URL: {YOUR_ORIGIN}/api/github/app/callback
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# --- Vercel OAuth (required only for Vercel-hosted deployments) ---
# Callback URL: {YOUR_ORIGIN}/api/auth/vercel/callback
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# --- Sandbox Provider ---
# Set CLOUDFLARE_ACCOUNT_ID to use Cloudflare Containers as the sandbox.
# If not set, defaults to Vercel Sandbox.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Cloudflare-specific (optional) ---
# CLOUDFLARE_CONTAINER_IMAGE=   # Custom container image for sandboxes
# CF_PAGES_URL=                 # Auto-set by Cloudflare Pages

# --- Vercel-specific (optional) ---
# VERCEL_PROJECT_PRODUCTION_URL=
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_SANDBOX_BASE_SNAPSHOT_ID=

# --- App URL (optional, for any hosting platform) ---
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Cache / KV (optional) ---
# Redis URL for caching. If not set, uses in-memory cache.
# Works with: Upstash Redis, self-hosted Redis, etc.
# REDIS_URL=
# KV_URL=

# --- Optional integrations ---
# ELEVENLABS_API_KEY=
